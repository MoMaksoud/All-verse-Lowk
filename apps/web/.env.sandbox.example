# Copy to .env.sandbox.local (ignored). Use keys from the SAME Stripe sandbox.
# The local runner can reuse test keys already in .env.local; it refuses live keys.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# For a real Stripe CLI forwarding session, use the whsec_ value printed by that session.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Firebase, shipping and email isolation are enforced by pnpm dev:sandbox.
