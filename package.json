{
  "name": "marketplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform marketplace app with shared UI components",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "build:mobile:ios": "eas build --platform ios --profile production --working-dir apps/mobile",
    "build:mobile:ios:preview": "eas build --platform ios --profile preview --working-dir apps/mobile",
    "dev:sandbox": "node scripts/payments/sandbox.mjs",
    "payments:emulators": "npx -y firebase-tools@latest emulators:start --config firebase.sandbox.json --project demo-allverse-sandbox --only auth,firestore",
    "payments:seed": "node scripts/payments/seed-sandbox.mjs",
    "payments:verify": "node scripts/payments/verify-sandbox.mjs",
    "payments:listen": "node scripts/payments/listen-sandbox.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.1",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react-dom": "^18.3.1"
    }
  }
}
