{
  "name": "marketplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform marketplace app with shared UI components",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "emulators": "npx -y firebase-tools emulators:start --only auth,firestore,storage --project demo-allverse",
    "sandbox": "npx -y firebase-tools emulators:exec --ui --only auth,firestore,storage --project demo-allverse \"pnpm --filter @marketplace/web seed:local && pnpm --filter @marketplace/web dev:local\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "build:mobile:ios": "eas build --platform ios --profile production --working-dir apps/mobile",
    "build:mobile:ios:preview": "eas build --platform ios --profile preview --working-dir apps/mobile"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.1",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react-dom": "^18.3.1"
    }
  }
}
